<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backcolor_app"
    android:padding="16dp"
    tools:context=".modulos.home.ui.MainActivity">

    <!-- 1. BLOQUE SUPERIOR (1/3 de la pantalla): Analizador y datos básicos -->
    <com.example.kotlin_music_v10.modulos.home.ui.EqualizadorView
        android:id="@+id/spectrumVisualizer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#05000000"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCancion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Título de la Canción Actual"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spectrumVisualizer" />

    <!-- 2. BLOQUE CENTRAL: El listado envuelto en un CardView con esquinas redondeadas -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContenedorLista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="36dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/backcolor_app"
        app:layout_constraintBottom_toTopOf="@id/seekBarProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCancion">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCanciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_main" />

    </androidx.cardview.widget.CardView>

    <!-- 3. BLOQUE INFERIOR: Barra de tiempo y mandos multimedia -->
    <SeekBar
        android:id="@+id/seekBarProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:foreground="@color/primario"
        app:layout_constraintBottom_toTopOf="@id/btnPlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="14sp"
        android:textColor="@color/secundario"
        app:layout_constraintStart_toStartOf="@id/seekBarProgress"
        app:layout_constraintTop_toBottomOf="@id/seekBarProgress" />

    <TextView
        android:id="@+id/txtDuracion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03:45"
        android:textSize="14sp"
        android:textColor="@color/secundario"
        app:layout_constraintEnd_toEndOf="@id/seekBarProgress"
        app:layout_constraintTop_toBottomOf="@id/seekBarProgress" />

    <!-- Mandos de control estilizados con color -->
    <!-- Botón de Atrás -->
    <ImageButton
        android:id="@+id/btnAtras"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Atrás"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_previous"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/btnPlay"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPlay" />

    <!-- Botón de Play Central -->
    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="?attr/colorPrimary"        android:elevation="4dp"
        android:contentDescription="Play o Pause"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_play"
        app:tint="?android:attr/colorBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botón de Adelante -->
    <ImageButton
        android:id="@+id/btnAdelante"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Adelante"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_next"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/btnPlay"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPlay" />

</androidx.constraintlayout.widget.ConstraintLayout>